# ============================================================
# BookSwipe - .gitignore (monorepo: backend/ + frontend/)
# ============================================================

# ---------- Segredos e variáveis de ambiente ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Java / Maven (backend) ----------
backend/target/
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/maven-wrapper.jar
hs_err_pid*.log
replay_pid*.log
# Ficheiro gerado pelo Spring Initializr
HELP.md

# ---------- Gradle (caso mudem de Maven) ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ---------- Node / Vite (frontend) ----------
node_modules/
frontend/dist/
dist/
dist-ssr/
.vite/
*.local
coverage/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Base de dados e dados locais ----------
# Dados do PostgreSQL se usarem bind mount em vez de volume nomeado
pgdata/
# Dumps da Open Library e ficheiros de importação (são grandes).
# Só a pasta data/ na raiz, para não apanhar pacotes ou pastas de código com esse nome.
/data/
*.txt.gz
*.dump
*.sql.gz

# ---------- Logs ----------
logs/
*.log

# ---------- IDEs e editores ----------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
backend/out/
# VS Code (manter só as recomendações de extensões, se existirem)
.vscode/*
!.vscode/extensions.json
# Neovim / Vim
*.swp
*.swo
*~
Session.vim
.netrwhist
# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini
.directory